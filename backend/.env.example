# Salin ke .env lalu isi, atau jalankan: python scripts/init_env.py
# JANGAN commit file .env.

# Wajib, minimal 32 karakter acak (mis. python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=

# Opsional. Default: SQLite di backend/upm_chess.db
# DATABASE_URL=sqlite:///./upm_chess.db

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Daftar origin yang diizinkan (dipisah koma). "*" cukup untuk demo/mobile; batasi jika dipasang di web publik.
CORS_ORIGINS=*

# Administrator awal: dibuat otomatis saat backend start jika belum ada admin.
ADMIN_NAME=Administrator UPM Chess Club
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=akuadmin123

# Hanya untuk demo di hosting gratis (disk sementara). Isi 1 agar data uji "[UJI]" dibuat otomatis jika database kosong.
# Akun uji memakai password publik (DemoUji123): matikan setelah demo.
# SEED_DEMO=1
